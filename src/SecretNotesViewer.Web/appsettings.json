{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "SignedOutRedirectUri": "/",
    "ResponseType": "code",
    "UsePkce": true,
    "ClientCredentials": [
      {
        "SourceType": "ClientSecret"
      }
    ]
  },
  "NoteContent": {
    "Provider": "InMemory"
  }
}
