@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-4">Secret Notes Viewer Lite</h1>
    <p class="lead">A security-focused Azure learning project.</p>
</div>

<div class="mx-auto" style="max-width: 48rem;">
    <h2>Current milestone</h2>
    <p><strong>B4-D6 — Closed Notes Catalog and Application Service Boundary</strong></p>

    <h2 class="h4 mt-4">Authentication state</h2>
    <p>@(User.Identity?.IsAuthenticated == true ? "Signed in" : "Not signed in")</p>

    <p>
        Local sign-in and sign-out remain implemented. The home page, Privacy page, and
        <code>/health</code> remain public.
    </p>

    <h2 class="h4 mt-4">Protected Notes boundary</h2>
    <p>
        <code>/Notes</code> now requires the named <code>ReadSecretNotes</code> authorization
        policy, which requires the <code>SecretNotes.Reader</code> app role. After authorization,
        the page reads an application-owned closed catalog through a minimal service and
        content-provider boundary.
    </p>

    <h2 class="h4 mt-4">Deferred capabilities</h2>
    <ul>
        <li>Azure Key Vault retrieval</li>
        <li>Managed Identity</li>
        <li>Azure RBAC</li>
        <li>Deployment and infrastructure</li>
    </ul>
</div>
