@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-4">Secret Notes Viewer Lite</h1>
    <p class="lead">A security-focused Azure learning project.</p>
</div>

<div class="mx-auto" style="max-width: 48rem;">
    <h2>Current milestone</h2>
    <p><strong>B4-D4 — Local Microsoft Entra Authentication</strong></p>

    <h2 class="h4 mt-4">Authentication state</h2>
    <p>@(User.Identity?.IsAuthenticated == true ? "Signed in" : "Not signed in")</p>

    <p>
        Local sign-in and sign-out are implemented. The home page remains public, and
        <code>/health</code> remains public.
    </p>

    <h2 class="h4 mt-4">Deferred capabilities</h2>
    <ul>
        <li><code>SecretNotes.Reader</code> enforcement</li>
        <li><code>/Notes</code></li>
        <li>Azure Key Vault</li>
        <li>Managed Identity</li>
        <li>Azure deployment and infrastructure</li>
    </ul>
</div>
